{
  "compilerOptions": {
    "allowJs": false,
    "checkJs": false,
    "declaration": false,
    "esModuleInterop": true,
    "module": "Node16",
    "moduleDetection": "force",
    "moduleResolution": "Node16",
    "noEmit": false,
    "outDir": "dist",
    "resolveJsonModule": true,
    "rootDir": "src",
    "strict": true,
    "target": "ES2022",
    "types": ["node"],
    "skipLibCheck": true
  },
  "include": [
    "src/**/*.ts"
  ],
  "exclude": [
    "dist",
    "node_modules"
  ]
}
